yle;rounded=1;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="455" /></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="455" /></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="X(L) cannot be removed by design, only measured. Residual language effect = variation in A(L) that survives adjustment for X(L), fertility and translation quality. With five or six languages this is a descriptive quantity; the paired item design supports claims about cells, not about languages in general." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="900" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>