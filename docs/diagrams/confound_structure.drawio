<mxfile host="qc_native_preference_tuning"><diagram name="confound_structure" id="confound_structure"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;What stands between 'the language' and the accuracy we measure.&lt;/b&gt; Green: pinned by design. Blue: measured and reported as a covariate. Red: cannot be removed, only made visible. Arrows point from cause to effect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="50" as="geometry" /></mxCell><mxCell id="c3" value="Language of the medium L&lt;br&gt;(treatment)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="70" as="geometry" /></mxCell><mxCell id="c4" value="Measured accuracy A(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="420" width="220" height="70" as="geometry" /></mxCell><mxCell id="c5" value="Base-model pretraining exposure X(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="320" height="60" as="geometry" /></mxCell><mxCell id="c6" value="Translator competence in L&lt;br&gt;-&gt; training data quality and eval item validity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="320" height="60" as="geometry" /></mxCell><mxCell id="c7" value="Tokenizer fertility&lt;br&gt;-&gt; tokens per item, truncation, cap effects" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="320" height="60" as="geometry" /></mxCell><mxCell id="c8" value="Register and orthography choice&lt;br&gt;(ngoko, loma, dialect)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="320" height="60" as="geometry" /></mxCell><mxCell id="c9" value="Indonesian leakage in outputs&lt;br&gt;(Minangkabau, Banjar)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="320" height="60" as="geometry" /></mxCell><mxCell id="c10" value="Contamination asymmetry&lt;br&gt;(English test items seen in pretraining)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="320" height="60" as="geometry" /></mxCell><mxCell id="c11" value="Scorer language dependence&lt;br&gt;(numeric match, choice letter only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="320" height="60" as="geometry" /></mxCell><mxCell id="c12" value="AutoScientist optimization and judge&lt;br&gt;(pinned hyperparameters, no early stop)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="320" height="60" as="geometry" /></mxCell><mxCell id="c13" value="Run-to-run variance&lt;br&gt;(3 replicates, run random effect)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="850" width="320" height="60" as="geometry" /></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge