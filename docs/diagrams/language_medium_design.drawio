50" y="468" width="120" height="53" as="geometry" /></mxCell><mxCell id="c52" value="tier 2  pooled: one model on all languages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="526" width="270" height="53" as="geometry" /></mxCell><mxCell id="c53" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c54" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c55" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c56" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="690" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c57" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c58" value="A_all(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="950" y="526" width="120" height="53" as="geometry" /></mxCell><mxCell id="c59" value="tier 1  native + english_anchor on the contrast base" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="584" width="270" height="53" as="geometry" /></mxCell><mxCell id="c60" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c61" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c62" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c63" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c64" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c65" value="A^B(L)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="950" y="584" width="120" height="53" as="geometry" /></mxCell><mxCell id="c66" value="&lt;b&gt;Estimands per language L&lt;/b&gt;&lt;br&gt;B(L) base level; A(L) native accuracy; G(L) = A(L) - B(L) gain from native tuning; Delta_en(L) = A_en(L) - A(L) anchor advantage;&lt;br&gt;Reg(L) English regression; A(en) - RT(L) translator-loss bound; tau(L, L') = A(L) - A(L') the descriptive cross-language contrast." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="662" width="560" height="90" as="geometry" /></mxCell><mxCell id="c67" value="&lt;b&gt;Replication and inference&lt;/b&gt;&lt;br&gt;3 replicate finetunes per model (count confirmed by a variance pilot); items paired across languages by source id;&lt;br&gt;paired item bootstrap and a mixed-effects logistic model; Holm on the primary family." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="662" width="480" height="90" as="geometry" /></mxCell><mxCell id="c68" value="&lt;b&gt;Covariates reported next to every cell&lt;/b&gt;&lt;br&gt;base-model bits per byte on FLORES-200, tokenizer fertility per item, translation quality columns per item, Indonesian leakage, output-language fidelity, output tokens and cap hits." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="762" width="560" height="80" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;Adding a language&lt;/b&gt;&lt;br&gt;one file configs/language/{code}.yaml plus the code in the series list; the matrix, names and commands follow from pipeline/plan.py." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="762" width="480" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>